#!/usr/bin/env bash
#MISE description="Run pi coding agent in a Docker container"
#MISE raw=true
#MISE dir="{{cwd}}"
set -euo pipefail

# shellcheck source=tasks/pi/_docker_flags
source "$(dirname "$0")/_docker_flags"

DOCKER_FLAGS+=("--interactive")
[ -t 0 ] && [ -t 1 ] && DOCKER_FLAGS+=("--tty")

if [ -n "${TMUX:-}" ]; then
  tmux set-option -p allow-passthrough on 2>/dev/null || true
  trap 'tmux set-option -p allow-passthrough off 2>/dev/null || true' EXIT
fi

PI_ARGS=()
if [[ -z "${PI_NO_CONTAINER_PROMPT:-}" ]]; then
  _pi_prompt="You are running inside a Docker container as a non-root user. No Docker socket, sudo, or system package installation (apk requires root) is available."
  if [[ -n "${PI_GPU:-}" ]]; then
    _pi_prompt+=" An NVIDIA GPU is available via CUDA; the driver is injected at container start, so install CUDA-enabled packages from the language ecosystem (e.g. torch from the PyTorch cu128 wheel index) rather than system CUDA."
  fi
  PI_ARGS+=("--append-system-prompt" "${_pi_prompt}")
  unset _pi_prompt
fi

"${DOCKER_CMD}" run "${DOCKER_FLAGS[@]}" "${PI_IMAGE}" "${PI_ARGS[@]}" "$@"
